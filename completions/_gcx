#compdef gcx

# gcx zsh completion

_gcx_get_orgs() {
    local config_file="$HOME/.config/gcx/config.yaml"
    if [[ -f "$config_file" ]] && (( $+commands[yq] )); then
        yq '.organizations | keys | .[]' "$config_file" 2>/dev/null
    fi
}

_gcx_get_identities() {
    local org="$1"
    local config_file="$HOME/.config/gcx/config.yaml"
    if [[ -f "$config_file" ]] && (( $+commands[yq] )); then
        yq ".organizations.${org}.identities | keys | .[]" "$config_file" 2>/dev/null
    fi
}

